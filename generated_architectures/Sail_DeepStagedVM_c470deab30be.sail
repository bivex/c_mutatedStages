// =============================================================================
// Part 5: Dynamic Metamorphic State Mutators (4 Micro-Stages)
// =============================================================================

val stage_mutator_lfsr_clock : unit -> unit
function stage_mutator_lfsr_clock() = {
    let lsb : bits(1) = [R_ENTROPY[0]] in
    if lsb == 0b1 then {
        R_ENTROPY = (R_ENTROPY >> 1) ^ 0x800000000000000D;
    } else {
        R_ENTROPY = R_ENTROPY >> 1;
    };
    LATCHES.stage_cycle = LATCHES.stage_cycle + 1;
}

val stage_mutator_key_diffusion : unit -> unit
function stage_mutator_key_diffusion() = {
    R_ENTROPY = R_ENTROPY + LATCHES.final_result;
    LATCHES.stage_cycle = LATCHES.stage_cycle + 1;
}

val stage_mutator_shadow_permute : unit -> unit
function stage_mutator_shadow_permute() = {
    LATCHES.stage_cycle = LATCHES.stage_cycle + 1;
}

val stage_mutator_epoch_barrier : unit -> unit
function stage_mutator_epoch_barrier() = {
    LATCHES.stage_cycle = LATCHES.stage_cycle + 1;
}

// =============================================================================
// Part 6: State Commit & Writeback (4 Micro-Stages)
// =============================================================================

val stage_commit_writeback_gpr : unit -> unit
function stage_commit_writeback_gpr() = {
    R_GPR[LATCHES.decoded_rd] = LATCHES.final_result;
    LATCHES.stage_cycle = LATCHES.stage_cycle + 1;
}

val stage_commit_advance_pc : unit -> unit
function stage_commit_advance_pc() = {
    R_PC = R_PC + 8;
    LATCHES.stage_cycle = LATCHES.stage_cycle + 1;
}

val stage_commit_check_halt : unit -> unit
function stage_commit_check_halt() = {
    if LATCHES.decoded_op == 0xFF then {
        LATCHES.vm_halted = true;
    };
    LATCHES.stage_cycle = LATCHES.stage_cycle + 1;
}

val stage_commit_clear_latches : unit -> unit
function stage_commit_clear_latches() = {
    LATCHES.carry_bits = zeros(65);
    LATCHES.bitslice_sum = zeros(64);
    LATCHES.stage_cycle = LATCHES.stage_cycle + 1;
}

// =============================================================================
// Master Execution Cycle (112 Sequential Formal Micro-Stages)
// =============================================================================

val step_instruction_cycle : unit -> unit
function step_instruction_cycle() = {
    // 1. Feistel Decryption Rounds (16 stages)
    stage_feistel_round_0();
    stage_feistel_round_1();
    stage_feistel_round_2();
    stage_feistel_round_3();
    stage_feistel_round_4();
    stage_feistel_round_5();
    stage_feistel_round_6();
    stage_feistel_round_7();
    stage_feistel_round_8();
    stage_feistel_round_9();
    stage_feistel_round_10();
    stage_feistel_round_11();
    stage_feistel_round_12();
    stage_feistel_round_13();
    stage_feistel_round_14();
    stage_feistel_round_15();

    // 2. Frontend Decode & Reassembly (8 stages)
    stage_frontend_reassemble();
    stage_frontend_decode_op();
    stage_frontend_decode_regs();
    stage_frontend_fetch_rs1();
    stage_frontend_fetch_rs2();
    stage_frontend_latch_init_carry();
    stage_frontend_forwarding_check_a();
    stage_frontend_forwarding_check_b();

    // 3. Bit-Sliced 64-bit Adder Network (64 stages)
    stage_bitslice_adder_0();
    stage_bitslice_adder_1();
    stage_bitslice_adder_2();
    stage_bitslice_adder_3();
    stage_bitslice_adder_4();
    stage_bitslice_adder_5();
    stage_bitslice_adder_6();
    stage_bitslice_adder_7();
    stage_bitslice_adder_8();
    stage_bitslice_adder_9();
    stage_bitslice_adder_10();
    stage_bitslice_adder_11();
    stage_bitslice_adder_12();
    stage_bitslice_adder_13();
    stage_bitslice_adder_14();
    stage_bitslice_adder_15();
    stage_bitslice_adder_16();
    stage_bitslice_adder_17();
    stage_bitslice_adder_18();
    stage_bitslice_adder_19();
    stage_bitslice_adder_20();
    stage_bitslice_adder_21();
    stage_bitslice_adder_22();
    stage_bitslice_adder_23();
    stage_bitslice_adder_24();
    stage_bitslice_adder_25();
    stage_bitslice_adder_26();
    stage_bitslice_adder_27();
    stage_bitslice_adder_28();
    stage_bitslice_adder_29();
    stage_bitslice_adder_30();
    stage_bitslice_adder_31();
