    let b_bit : bits(1) = [LATCHES.operand_b[50]] in
    let c_in  : bits(1) = [LATCHES.carry_bits[50]] in
    let sum_bit : bits(1) = a_bit ^ b_bit ^ c_in in
    let c_out   : bits(1) = (a_bit & b_bit) | (c_in & (a_bit ^ b_bit)) in
    LATCHES.bitslice_sum[50] = sum_bit[0];
    LATCHES.carry_bits[51] = c_out[0];
    LATCHES.stage_cycle = LATCHES.stage_cycle + 1;
}

